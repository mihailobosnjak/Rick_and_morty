<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight tema: prati sistemski Dark Mode. -->
    <style name="Theme.AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!-- Sistemски splash (Android 12+), uz backport za starije. -->
    <style name="Theme.AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AppTheme</item>
    </style>
</resources>